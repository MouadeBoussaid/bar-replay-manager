{
  "name": "bar-replay-manager",
  "version": "0.8.0",
  "description": "Browse, favourite, and prune Beyond All Reason replay files",
  "main": "./out/main/index.js",
  "author": "mouade.boussaid@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:parser": "node scripts/parser-smoke.mjs",
    "test:stream": "node scripts/stream-smoke.mjs",
    "test": "npm run test:parser && npm run test:stream",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
